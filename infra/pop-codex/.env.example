# Echo self-hosted stack
# Portable: runs on any Linux box with Docker + 8GB RAM.
# Tested on: AMD Ryzen 5600G (no GPU), 62GB RAM, /mnt/ssd free.
#
# Boot any fresh box:
#   cd infra/pop-codex && cp .env.example .env && ./bootstrap.sh
# Move to another box on disaster:
#   ./backup.sh (push to S3/rsync) → on new box: ./restore.sh <backup.tar>

# ── Paths ─────────────────────────────────────────────
# Root for models, caches, audio. Override per host.
ECHO_DATA_DIR=/mnt/ssd/echo-stack

# Network (Cloud Run / dev tunneled via Tailscale)
ECHO_PUBLIC_HOST=pop-os-codex
KOKORO_PORT=5315
WHISPER_PORT=5316
SCORER_PORT=5317
RHUBARB_PORT=5318
PIPER_PORT=5319
EDGE_PROXY_PORT=5320

# ── Models (pinned versions, reproducible) ────────────
WHISPER_MODEL=base
PIPER_VOICE_EN=en_US-amy-medium
PIPER_VOICE_ES=es_MX-ald-medium
PIPER_VOICE_ZH=cmn_hans-cn-xiaoxiao-medium

# Optional cloud fallbacks (set to disable)
EDGE_TTS_FALLBACK=1
